{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.matricscorporation.com"
        }
      ],
      "destination": "https://matricscorporation.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?matricscorporation\\.co\\.in"
        }
      ],
      "destination": "https://matricscorporation.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|textures/).*)",
      "destination": "/index.html"
    }
  ]
}
